#include "resource.h"

#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#define RT_MANIFEST 24

IDI_CODEX_ORGANIZER ICON "codex-organizer.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Aethertek"
      VALUE "FileDescription", "Codex Window Organizer - native Windows application"
      VALUE "FileVersion", "0.3.0"
      VALUE "InternalName", "CodexOrganizer"
      VALUE "OriginalFilename", "CodexOrganizer.exe"
      VALUE "ProductName", "Codex Window Organizer"
      VALUE "ProductVersion", "0.3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
